{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bend-lang.com/schema/graph-v1.json",
  "title": "Bend named dependency graph v1",
  "type": "object",
  "required": ["schema", "roots", "nodes"],
  "properties": {
    "schema": { "const": "bend.graph.v1" },
    "roots": { "type": "array", "items": { "type": "string" } },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "refs"],
        "properties": {
          "name": { "type": "string" },
          "refs": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
