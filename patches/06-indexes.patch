+{
+  "schema": "bend.diagnostics.v1",
+  "upstreamCommit": "e5a4c4cfe980c2e4e70571562efb5197fe27b2f4",
+  "ids": {
+    "BND000": {
+      "name": "check.ok",
+      "severity": "ok",
+      "why": "The checked book has no open goals.",
+      "next": "No repair required."
+    },
+    "BND101": {
+      "name": "proof.laws_import_missing",
+      "severity": "error",
+      "why": "PROOF.bend sits beside LAWS.bend but did not import it.",
+      "next": "Import ./LAWS.bend as a module, then recheck."
+    },
+    "BND102": {
+      "name": "proof.unsafe_import",
+      "severity": "error",
+      "why": "The proof import graph contains @unsafe, so the proof is outside Bend's trusted live theory.",
+      "next": "Remove the unsafe dependency or prove the required lemma without it."
+    },
+    "BND103": {
+      "name": "check.incomplete",
+      "severity": "error",
+      "why": "One or more TODO or open law goals remain.",
+      "next": "Inspect the first residual goal and select one proof move."
+    },
+    "BND110": {
+      "name": "checker.error",
+      "severity": "error",
+      "why": "The Bend checker rejected a term, type, quantity, rewrite, pattern, or proof obligation.",
+      "next": "Use the reported expected/observed terms, then load only the proof move or Base name needed by that distinction."
+    },
+    "BND120": {
+      "name": "host.stack",
+      "severity": "error",
+      "why": "Host recursion or literal expansion exhausted the machine stack.",
+      "next": "Reduce recursion depth or literal expansion before changing proof structure."
+    },
+    "BND200": {
+      "name": "cli.usage",
+      "severity": "error",
+      "why": "The requested CLI form or named graph root is invalid.",
+      "next": "Correct the command or request a checked name."
+    },
+    "BND300": {
+      "name": "build.failed",
+      "severity": "error",
+      "why": "The external compiler or backend build failed after Bend checking.",
+      "next": "Inspect the build lane; do not change proof theory."
+    }
+  }
+}
